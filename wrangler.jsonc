{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asif-store",
  "main": "./Server.js",
  "compatibility_date": "2026-09-28",

  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asif-store-db",
      "database_id": "390e8097-6d15-436f-9811-056a205b1f0d"
    }
  ]
}
